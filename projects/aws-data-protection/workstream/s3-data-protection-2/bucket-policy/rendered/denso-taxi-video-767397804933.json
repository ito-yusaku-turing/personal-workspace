{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::994354357515:root",
          "arn:aws:iam::471112873671:root"
        ]
      },
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::denso-taxi-video-767397804933",
        "arn:aws:s3:::denso-taxi-video-767397804933/*"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::994354357515:role/feature-cache-job-role",
            "arn:aws:iam::471112873671:role/feature-cache-job-role"
          ]
        }
      }
    },
    {
      "Sid": "DenyIrreversibleDelete",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::denso-taxi-video-767397804933",
        "arn:aws:s3:::denso-taxi-video-767397804933/*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::767397804933:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_FullAccess_*",
            "arn:aws:iam::767397804933:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AWSAdministratorAccess_*"
          ]
        }
      }
    },
    {
      "Sid": "DenyProtectionRemoval",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketAcl"
      ],
      "Resource": "arn:aws:s3:::denso-taxi-video-767397804933",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::767397804933:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_FullAccess_*",
            "arn:aws:iam::767397804933:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_AWSAdministratorAccess_*",
            "arn:aws:iam::767397804933:role/cdk-hnb659fds-cfn-exec-role-767397804933-*"
          ]
        }
      }
    }
  ]
}